# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings → API). Restart `pnpm dev` after changing these.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Whoever signs in with this Google address becomes the coach; every other
# address is a player (ADR-006). NEXT_PUBLIC_ because the check runs in the
# browser — the app has no server side.
NEXT_PUBLIC_COACH_EMAIL=hernandiazz99@gmail.com
